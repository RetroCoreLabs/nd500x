#!/usr/bin/env python3
"""
gen-asm-map - Generate assembly source line to address mappings

This tool parses ND-500 assembly (.s) files and generates map file entries
that map assembly source lines to their corresponding addresses in the object code.

The output is in the standard map file format used by nd500-as and nd500-ld,
allowing these entries to be merged with C source mappings from stabs debug info.

Usage:
    gen-asm-map <input.s> [output.map]
    gen-asm-map <input.s> > output.map

Author: ND500X Project
License: Same as ND500X project
"""

import sys
import re
from typing import List, Tuple, Optional

class AsmMapGenerator:
    """Generate assembly line→address mappings from .s files"""

    def __init__(self, source_file: str):
        self.source_file = source_file
        self.current_address = 0
        self.current_segment = 'T'  # TEXT by default
        self.mappings: List[Tuple[int, int, str]] = []  # (line_num, address, segment)

    def parse_line(self, line_num: int, line: str) -> None:
        """Parse a single assembly line and track address changes"""

        # Strip comments (everything after ';' or '#')
        line = re.sub(r'[;#].*$', '', line).strip()

        if not line:
            return

        # Handle .org directive (sets current address)
        org_match = re.match(r'\.org\s+(\d+|0x[0-9a-fA-F]+|0[0-7]+)', line, re.IGNORECASE)
        if org_match:
            addr_str = org_match.group(1)
            if addr_str.startswith('0x'):
                self.current_address = int(addr_str, 16)
            elif addr_str.startswith('0') and len(addr_str) > 1:
                self.current_address = int(addr_str, 8)
            else:
                self.current_address = int(addr_str)
            return

        # Handle segment directives
        if re.match(r'\.text', line, re.IGNORECASE):
            self.current_segment = 'T'
            return
        elif re.match(r'\.data', line, re.IGNORECASE):
            self.current_segment = 'D'
            return
        elif re.match(r'\.bss', line, re.IGNORECASE):
            self.current_segment = 'B'
            return

        # Handle labels (don't generate code, don't advance address)
        if re.match(r'^[a-zA-Z_][a-zA-Z0-9_]*:', line):
            return

        # Handle assembler directives that don't generate code
        if re.match(r'\.(globl|extern|comm|lcomm|align|file|stabs)', line, re.IGNORECASE):
            return

        # Handle data directives that generate bytes
        word_match = re.match(r'\.word\s+', line, re.IGNORECASE)
        byte_match = re.match(r'\.byte\s+', line, re.IGNORECASE)
        long_match = re.match(r'\.long\s+', line, re.IGNORECASE)

        if word_match:
            # .word generates 2 bytes
            self.mappings.append((line_num, self.current_address, self.current_segment))
            self.current_address += 2
            return
        elif byte_match:
            # .byte generates 1 byte per value
            self.mappings.append((line_num, self.current_address, self.current_segment))
            # Count comma-separated values
            values = line[6:].split(',')
            self.current_address += len(values)
            return
        elif long_match:
            # .long generates 4 bytes
            self.mappings.append((line_num, self.current_address, self.current_segment))
            self.current_address += 4
            return

        # If line contains an instruction mnemonic, it generates code
        # ND-500 instructions are variable length (2-10 bytes), default to 2
        instruction_pattern = r'^\s*[a-zA-Z][a-zA-Z0-9]*\s'
        if re.match(instruction_pattern, line):
            self.mappings.append((line_num, self.current_address, self.current_segment))
            # Estimate instruction length (actual length varies)
            # For accurate results, would need full instruction decoder
            self.current_address += 2  # Most instructions are at least 2 bytes
            return

    def generate_map(self) -> str:
        """Generate map file content from parsed mappings"""
        lines = [
            f"; Map file for {self.source_file}",
            "; Format: filename:line (SEG) -> address (octal)  # segment_name",
            "; Generated by gen-asm-map",
            ";"
        ]

        for line_num, address, segment in self.mappings:
            seg_name = {'T': 'TEXT', 'D': 'DATA', 'B': 'BSS'}.get(segment, 'TEXT')
            # Format address as octal (ND-500 convention)
            lines.append(f"{self.source_file}:{line_num} ({segment}) -> {address:06o}  # {seg_name}")

        return '\n'.join(lines) + '\n'

    def process_file(self) -> str:
        """Read assembly file and generate map entries"""
        try:
            with open(self.source_file, 'r') as f:
                for line_num, line in enumerate(f, start=1):
                    self.parse_line(line_num, line)
        except FileNotFoundError:
            print(f"Error: File not found: {self.source_file}", file=sys.stderr)
            sys.exit(1)
        except Exception as e:
            print(f"Error reading {self.source_file}: {e}", file=sys.stderr)
            sys.exit(1)

        return self.generate_map()

def main():
    if len(sys.argv) < 2 or sys.argv[1] in ['-h', '--help']:
        print(__doc__)
        print("\nExamples:")
        print("  gen-asm-map kernel.s > kernel_asm.map")
        print("  gen-asm-map kernel.s kernel_asm.map")
        print("  gen-asm-map locore.s | cat locore.map - > merged.map")
        sys.exit(0 if '-h' in sys.argv or '--help' in sys.argv else 1)

    input_file = sys.argv[1]
    output_file = sys.argv[2] if len(sys.argv) > 2 else None

    generator = AsmMapGenerator(input_file)
    map_content = generator.process_file()

    if output_file:
        try:
            with open(output_file, 'w') as f:
                f.write(map_content)
            print(f"Generated {len(generator.mappings)} mappings: {input_file} -> {output_file}",
                  file=sys.stderr)
        except Exception as e:
            print(f"Error writing {output_file}: {e}", file=sys.stderr)
            sys.exit(1)
    else:
        print(map_content, end='')

if __name__ == '__main__':
    main()
