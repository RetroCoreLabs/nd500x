# Build directories
build/
build_release/
build_wasm/
dist/
pkgroot/

# Compiled object files
*.o
*.a
*.so
*.dylib

# Executables
*.exe
*.out
/nd500x
nd500wasm.js
nd500wasm.wasm

# Generated files (now committed to src/cpu/ as source files)

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Debug files
*.dSYM/
*.su
*.idb
*.pdb

# CMake cache
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile
CTestTestfile.cmake
*.cmake
# ...but this one is hand-written source, not generated: it is the
# settings_no_getenv CTest gate (see src/cpu/nd500_settings.h).
!test/no_getenv_gate.cmake
# ...and the radix gate, likewise hand-written: it catches a literal written in
# octal whose own comment documents it as decimal (docs/INVESTIGATION-TRAPS.md).
!test/radix_gate.cmake
# ...and the mkptypes build copied from nd100x (tools/mkptypes/): its Makefile
# is source, not CMake output.
!tools/mkptypes/Makefile
# ...and the script that runs it over a source directory.
!cmake/mkptypes_gen.cmake

# Test files
test.o
*.test

# Node modules (if any)
node_modules/

# Emscripten cache
.emscripten_cache/

# History files
.nd500x_history

build-wasm/

# Emulator runtime artifacts (SINTRAN scratch/user dirs, trace logs)
/GUEST/
/SCRATCH/
nc_trace.log
SCRATCH-*.dat
/SCRATCH-00001:CAT.dat

# Backups and stray patches
*.bak
*.bak-*
*.patch

# Python bytecode from tools/
__pycache__/

# CTest scratch
Testing/

# machine-local run-ndix settings (absolute paths must not be committed)
run-ndix.local

# Scratch/work area used by tools/ndix scripts (ND500X_WORK default)
work/
build-opt/
build-base/
build-asan/

# The NDIX disk image staged into the Docker build context by docker/build.sh.
# 71 MB of a 1988 operating system - regenerable from the master, and it does
# not belong in git.
docker/disk/

# mkptypes, built at configure time from tools/mkptypes (same as nd100x).
/tools/mkptypes/mkptypes

# Auto-generated function prototype headers (produced by mkptypes at build time).
# Tracking these in git causes false-positive freshness checks: git checkout sets
# all files to the same mtime, so CMake skips regeneration even when the header
# is stale relative to its source - leading to "conflicting types" build errors.
*_protos.h
# nd500x exceptions: these two are hand-written, hold the CPU and machine
# types as well as prototypes, and are tracked.
!/src/cpu/cpu_protos.h
!/src/machine/machine_protos.h
