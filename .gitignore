!test/no_getenv_gate.cmake

# Test files
test.o
*.test

# Node modules (if any)
node_modules/

# Emscripten cache
.emscripten_cache/

# History files
.nd500x_history

build-wasm/

# Emulator runtime artifacts (SINTRAN scratch/user dirs, trace logs)
/GUEST/
/SCRATCH/
nc_trace.log
SCRATCH-*.dat
/SCRATCH-00001:CAT.dat

# Backups and stray patches
*.bak
*.bak-*
*.patch

# Python bytecode from tools/
__pycache__/

# CTest scratch
Testing/

# machine-local run-ndix settings (absolute paths must not be committed)
run-ndix.local

# Scratch/work area used by tools/ndix scripts (ND500X_WORK default)
work/
build-opt/
build-base/
build-asan/

# The NDIX disk image staged into the Docker build context by docker/build.sh.
# 71 MB of a 1988 operating system - regenerable from the master, and it does
# not belong in git.
docker/disk/
