<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Info.plist.in - macOS bundle description for nd500x.app

  configure_file() in CMakeLists.txt fills in the @...@ fields and writes
  Info.plist into the build tree; edit this file, not the generated one.
  The release workflow builds nd500x.app from it: Contents/MacOS/nd500x is
  the same binary the tarball ships on its own, and Contents/Resources/
  nd500x.icns is assets/nd500x.icns, which Finder shows for the bundle.
-->
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>nd500x</string>
    <key>CFBundleDisplayName</key>
    <string>nd500x</string>
    <key>CFBundleIdentifier</key>
    <string>com.retrocorelabs.nd500x</string>
    <key>CFBundleExecutable</key>
    <string>nd500x</string>
    <key>CFBundleIconFile</key>
    <string>nd500x</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>@nd500x_VERSION@</string>
    <key>CFBundleVersion</key>
    <string>@nd500x_VERSION@</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>NSHumanReadableCopyright</key>
    <string>Copyright (c) 2025-2026 Ronny Hansen</string>
</dict>
</plist>
